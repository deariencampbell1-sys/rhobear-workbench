{"ok":true,"count":23,"entries":[{"id":"rhobear-app","name":"RHOBEAR App Engine","description":"Local RHOBEAR sidecar \u2014 settings, MCP proxy, agent routing (port 7460 = DEFAULT_SETTINGS_PORT from engine/rhobear/ports.py)","long_description":"Local RHOBEAR sidecar \u2014 settings, MCP proxy, agent routing (port 7460 = DEFAULT_SETTINGS_PORT from engine/rhobear/ports.py). NOTE: 7460 stays a literal here because the JSON token resolver (engine/setup_agent/server/settings_api.py:_resolve_mcp_cmd_token, PR #238) only expands {RHOBEAR_*} tokens inside `cmd` strings \u2014 not `url`. If you change the port, update this entry AND the Rust const SETTINGS_API_PORT in installer/src-tauri/src/main.rs in lock-step.","vendor":"RHOBEAR","transport":"sse","source":"rhobear","accent":"#7dffd5","perms":"read, write","on":true,"categories":["RHOBEAR"],"tags":["rhobear","fleet","rhobear-app"]},{"id":"code-graph","name":"CodeGraph","description":"Symbol/dependency/route index on chat-brain-1","long_description":"Symbol/dependency/route index on chat-brain-1. Enable to use CodeGraph MCP for code navigation.","vendor":"RHOBEAR","transport":"sse","source":"rhobear","accent":"#60a5fa","perms":"read","on":false,"categories":["RHOBEAR"],"tags":["rhobear","fleet","code-graph"]},{"id":"rhobear-sup","name":"RHOBEAR Supervisor","description":"Supervisor wave/phase control on chat-brain-1","long_description":"Supervisor wave/phase control on chat-brain-1. Exposes kick/audit/status tools.","vendor":"RHOBEAR","transport":"sse","source":"rhobear","accent":"#ffb800","perms":"read, write","on":false,"categories":["RHOBEAR"],"tags":["rhobear","fleet","rhobear-sup"]},{"id":"rhobear-swarm","name":"Swarm Dispatch","description":"Swarm dispatch and nudge endpoints on chat-brain-1.","long_description":"Swarm dispatch and nudge endpoints on chat-brain-1.","vendor":"RHOBEAR","transport":"sse","source":"rhobear","accent":"#F5A524","perms":"read, write","on":false,"categories":["RHOBEAR"],"tags":["rhobear","fleet","rhobear-swarm"]},{"id":"rhobear-vps","name":"RHOBEAR VPS","description":"Hetzner rhobear-vps utilities \u2014 file sync and general helper.","long_description":"Hetzner rhobear-vps utilities \u2014 file sync and general helper.","vendor":"RHOBEAR","transport":"sse","source":"rhobear","accent":"#7c5cff","perms":"read","on":false,"categories":["RHOBEAR"],"tags":["rhobear","fleet","rhobear-vps"]},{"id":"rhobear-bld","name":"Build Keeper","description":"Build VM lifecycle controller \u2014 start/deallocate/fire rhobear-bld-01 via the keeper.","long_description":"Build VM lifecycle controller \u2014 start/deallocate/fire rhobear-bld-01 via the keeper.","vendor":"RHOBEAR","transport":"sse","source":"rhobear","accent":"#34d399","perms":"read, write","on":false,"categories":["RHOBEAR"],"tags":["rhobear","fleet","rhobear-bld"]},{"id":"rhobear-files","name":"RHOBEAR Filesystem","description":"Filesystem MCP scoped to ~/Documents for agent file tasks.","long_description":"Filesystem MCP scoped to ~/Documents for agent file tasks.","vendor":"RHOBEAR","transport":"stdio","source":"rhobear","accent":"#7dffd5","perms":"read, write","on":false,"categories":["RHOBEAR"],"tags":["rhobear","fleet","rhobear-files"]},{"id":"filesystem","name":"Filesystem","description":"Read, write, and manage files and directories on the local machine.","long_description":"The reference filesystem server from the MCP team. Exposes tools to list directories, read file contents, write files, move/copy/delete, and search by glob. Scoped to one or more allowed root directories you specify at install time.","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["productivity","developer"],"tags":["files","local","productivity"],"install_method":"npx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/filesystem"},{"id":"git","name":"Git","description":"Read git repository state \u2014 log, diff, status, branches, blame.","long_description":"Read-only access to a local git repository. Tools for log, diff, status, branch list, blame, and show. Useful for letting the crew answer questions like 'what changed in the last 5 commits on main' without copying files in.","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["developer"],"tags":["git","vcs","read"],"install_method":"npx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/git"},{"id":"github","name":"GitHub","description":"Repos, issues, pull requests, and Actions on github.com via the REST API.","long_description":"Read and write access to GitHub \u2014 list repos, read/create issues, comment on PRs, search code, trigger workflows. Requires a personal access token (classic or fine-grained).","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["developer","productivity"],"tags":["github","git","api"],"install_method":"npx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/github"},{"id":"fetch","name":"Web Fetch","description":"Fetch arbitrary URLs and convert HTML to readable Markdown.","long_description":"A simple, model-friendly HTTP fetcher. Takes a URL, fetches the page, and returns the cleaned-up Markdown. Great for one-off lookups when you don't want to grant the crew a full browser.","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["search","developer"],"tags":["http","web","fetch"],"install_method":"uvx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/fetch"},{"id":"sqlite","name":"SQLite","description":"Query and modify local SQLite database files via SQL.","long_description":"Connect to a local .db file and run SQL queries. Returns rows as JSON. Supports list_tables, describe_table, and execute_sql. Useful for letting the crew answer questions about a local dataset.","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["data","developer"],"tags":["sql","database","local"],"install_method":"uvx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/sqlite"},{"id":"postgres","name":"PostgreSQL","description":"Query a Postgres database via the standard libpq connection string.","long_description":"Connect to any Postgres instance reachable from this machine via a libpq connection URL. Tools: list_schemas, list_tables, describe_table, execute_sql. Read-only by default unless you pass ?sslmode=disable and the user has write perms.","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["data","developer"],"tags":["sql","postgres","database"],"install_method":"uvx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/postgres"},{"id":"slack","name":"Slack","description":"Read channels, post messages, and react \u2014 via a Slack bot token.","long_description":"Connect to your Slack workspace with a bot token (xoxb-\u2026). Lists channels, reads message history, posts messages, and reacts to messages. Requires the bot to be installed in the workspace with chat:write scope.","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["messaging","productivity"],"tags":["slack","chat","messaging"],"install_method":"npx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/slack"},{"id":"notion","name":"Notion","description":"Read and write Notion pages, databases, and comments.","long_description":"Connect to Notion via an internal integration token. Lists pages and databases, reads blocks, creates pages, queries database items, and appends content. Token must be created at notion.so/my-integrations and shared with the target pages.","vendor":"mcp-london","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["productivity","docs"],"tags":["notion","docs","wiki"],"install_method":"npx","repo_url":"https://github.com/makenotion/notion-mcp-server"},{"id":"linear","name":"Linear","description":"Read and write Linear issues, projects, and cycles.","long_description":"Connect to Linear with a personal API key. Lists teams/projects/issues, creates and updates issues, adds comments. API key from linear.app/settings/api.","vendor":"linear","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["productivity"],"tags":["linear","issues","project-management"],"install_method":"npx","repo_url":"https://linear.app/docs/mcp"},{"id":"stripe","name":"Stripe","description":"Read Stripe customers, charges, subscriptions, and payouts.","long_description":"Connect to Stripe with a restricted secret key. Read-only access to customers, charges, subscriptions, invoices, balance, and payouts. Useful for letting the crew answer 'who paid us last week'.","vendor":"stripe","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["finance"],"tags":["stripe","payments","finance"],"install_method":"npx","repo_url":"https://github.com/stripe/agent-toolkit"},{"id":"telegram","name":"Telegram","description":"Read and post Telegram messages via a user or bot token.","long_description":"Connect to Telegram with a bot token (recommended) or user session. Lists chats, reads message history, posts messages, and downloads media. Bot token from @BotFather.","vendor":"community","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["messaging"],"tags":["telegram","messaging"],"install_method":"uvx","repo_url":"https://github.com/chigwell/telegram-mcp"},{"id":"brave-search","name":"Brave Search","description":"Web search via the Brave Search API.","long_description":"Search the live web via Brave. Returns ranked results with snippets. Requires a Brave Search API key (free tier available at brave.com/search/api).","vendor":"brave","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["search"],"tags":["search","web"],"install_method":"npx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/brave-search"},{"id":"google-drive","name":"Google Drive","description":"Read and write Google Drive files and folders.","long_description":"Connect to Google Drive with OAuth credentials. Lists files, reads content, creates new files, and shares. Requires Google Cloud project with Drive API enabled.","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["productivity","docs"],"tags":["google","drive","docs"],"install_method":"npx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/gdrive"},{"id":"puppeteer","name":"Puppeteer","description":"Headless browser automation \u2014 navigate, click, screenshot.","long_description":"Drive a headless Chromium via Puppeteer. Navigate to URLs, click elements, fill forms, take screenshots, extract page text. Useful when fetch is not enough and the crew needs to actually click through a page.","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["developer","automation"],"tags":["browser","automation","puppeteer"],"install_method":"npx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/puppeteer"},{"id":"memory","name":"Memory (Knowledge Graph)","description":"Persistent knowledge graph \u2014 entities, relations, observations.","long_description":"A built-in knowledge graph that lets the crew remember facts across sessions. Tools to create entities, add observations, and create relations between them. Storage is local (a JSON file in the server's working dir).","vendor":"modelcontextprotocol","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["productivity"],"tags":["memory","knowledge-graph","local"],"install_method":"npx","repo_url":"https://github.com/modelcontextprotocol/servers/tree/main/src/memory"},{"id":"figma","name":"Figma","description":"Read Figma files \u2014 frames, components, and styles.","long_description":"Connect to Figma with a personal access token. Lists files, reads frames, components, and styles. Write support is limited \u2014 primarily for reading design context into the crew's working memory.","vendor":"community","transport":"stdio","source":"registry","accent":null,"perms":"","on":false,"categories":["design"],"tags":["figma","design"],"install_method":"uvx","repo_url":"https://github.com/moonray/figma-mcp"}]}